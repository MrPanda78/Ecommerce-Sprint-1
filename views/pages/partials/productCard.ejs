<div class="product-card">
    <div class="product-img">
        <img src="<%= image %>" alt="<%= name %>">
    </div>
    <div class="product-info">
        <p class="product-name"><%= name %></p>
        <div class="product-price">
        <span class="price"><%= points %></span>
        <span class="currency">Puntos</span>
        </div>
    </div>
</div>