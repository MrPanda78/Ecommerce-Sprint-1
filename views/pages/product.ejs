<link rel="stylesheet" href="/css/index.css">
<link rel="stylesheet" href="/css/productCard.css">
<link rel="stylesheet" href="/css/user-menu.css">
<link rel="stylesheet" href="/css/productContainer.css">
<link rel="stylesheet" href="/css/breadCrumb.css">
<link rel="stylesheet" href="/css/product.css">

<%- include('partials/user-menu') %>
<%- include('partials/header', { loggedIn: loggedIn }) %>
<main>
    <div class="container4">
        <%- include('partials/breadCrumb', { page: 'product' }) %>
        <%- include('partials/productContainer') %>
    </div>
    <div class="container4-mobile">
        <%- include('partials/breadCrumb', { page: 'product' }) %>
        <div class="product-container-mobile">
            <h2 class="title"><%= product.name %></h2>
            <div class="main-image-mobile">
                <img src="<%= product.images[0] %>" alt="producto" />
            </div>
            <div class="thumbs-mobile">
                <% product.images.forEach((img, i) => { %>
                    <img src="<%= img %>" class="thumb <%= i === 0 ? 'active' : '' %>" />
                <% }) %>
            </div>
            <div class="price">
                <span class="amount"><%= product.price %></span>
                <span class="points">PUNTOS</span>
            </div>
            <div class="description">
                <p><%- product.description.replace(/\n/g, "<br>") %></p>
            </div>
            <button class="btn-add">Agregar al carrito</button>
        </div>
    </div>
    <div class="container3">
        <h2 class="">También te puede interesar</h2>
        <div class="interests">
            <% interests.forEach(product => { %>
                <%- include('partials/productCard', { 
                    name: product.name,
                    image: product.image,
                    points: product.points
                }) %>
            <% }) %>
        </div>
    </div>
    <div class="container1">
        <%- include('partials/nav') %>
    </div>
</main>
<%- include('partials/footer') %>

<script>
    const userBtn = document.getElementById('userBtn');
    const dropdown = document.getElementById('userDropdown');

    userBtn.addEventListener('click', () => {
        dropdown.classList.toggle('open');
    });

    document.addEventListener('click', (e) => {
        if (!userBtn.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.remove('open');
        }
    });
</script>